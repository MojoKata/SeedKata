  "tools": [
    {
      "tool": "foundation-sdk",
      "path": "~/.foundation/sdk/current",
      "how": "curl -sSfL https://sdk.foundation.xyz/latest/install.sh | bash   # README.md, Prerequisites",
      "why": "make prime: the Foundation SDK builds, signs and packs the Prime app (the Makefile's FOUNDATION_SDK_ROOT)"
    },
    {
      "tool": "nix",
      "command": "nix",
      "how": "the Nix installer from https://nixos.org/download (flakes on); 'foundation doctor' checks it",
      "why": "make prime runs 'nix develop' on the Foundation SDK; the Makefile's JAVA_HOME is a Nix profile's JDK"
    },
    {
      "tool": "jdk17",
      "path": "~/.nix-profile/lib/openjdk",
      "how": "nix profile install nixpkgs#jdk17",
      "why": "make droid: Gradle and the Android build need JDK 17 (jvmTarget 17); the Makefile's JAVA_HOME"
    },
    {
      "tool": "android-platform-34",
      "path": "~/android-sdk/platforms/android-34",
      "how": "~/android-sdk/cmdline-tools/latest/bin/sdkmanager 'platforms;android-34'",
      "why": "make droid: compileSdk and targetSdk 34 (the Makefile's ANDROID_HOME is ~/android-sdk)"
    },
    {
      "tool": "android-build-tools-34",
      "path": "~/android-sdk/build-tools/34.0.0",
      "how": "~/android-sdk/cmdline-tools/latest/bin/sdkmanager 'build-tools;34.0.0'",
      "why": "make droid: Android Gradle Plugin 8.5's build tools for API 34"
    },
    {
      "tool": "adb",
      "path": "~/android-sdk/platform-tools/adb",
      "how": "~/android-sdk/cmdline-tools/latest/bin/sdkmanager platform-tools",
      "why": "installing the APK on a phone (README.md: adb install releases/droid/diceseed.apk)"
    }
  ],
