import { Theme, UISize, Images, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Navigate } from "../../gen/navigate.slint";
import { AppState } from "../../state.slint";
import { PageHeader } from "../../widgets.slint";

// Screen 3: Dice selection (requirement 1.3)
export component DieTypePagePage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-lg + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-xl;

        PageHeader {
            title: "Your Dice";
        }

        Text {
            text: "Which dice will you roll?";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-subtitle;
            font-weight: Theme.font-weight-medium;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: Theme.spacing-xl;

            VerticalLayout {
                spacing: Theme.spacing-lg;
                horizontal-stretch: 1;

                Rectangle {
                    height: 180px;
                    background: Theme.palette-card;
                    border-radius: Theme.radius-default;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: Images.image("die-d6");
                        image-fit: contain;
                    }
                }

                Button {
                    text: "6-sided";
                    size: ControlSize.lg;
                    full-width: true;
                    clicked => {
                        AppState.die-sides = 6;
                        Navigate.dice-quality-page({ });
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-lg;
                horizontal-stretch: 1;

                Rectangle {
                    height: 180px;
                    background: Theme.palette-card;
                    border-radius: Theme.radius-default;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: Images.image("die-d8");
                        image-fit: contain;
                    }
                }

                Button {
                    text: "8-sided";
                    size: ControlSize.lg;
                    full-width: true;
                    clicked => {
                        AppState.die-sides = 8;
                        Navigate.dice-quality-page({ });
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
