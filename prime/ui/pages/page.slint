import { Theme, UISize, Images, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../gen/navigate.slint";

// Screen 1: Launch screen (requirement 1.1)
export component MainPagePage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-xl;

        Text {
            text: "DiceSeed";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-body;
            font-weight: Theme.font-weight-semibold;
            horizontal-alignment: center;
        }

        // Steampunk dice banner: two d6 and two d8, rolling toward the
        // viewer, nearest die an 8-sided (requirements 1.1.1-1.1.4).
        Rectangle {
            width: 100%;
            height: 190px;
            background: Theme.palette-card;
            border-radius: Theme.radius-default;
            clip: true;

            Image {
                width: parent.width;
                height: parent.height;
                source: Images.image("dice-banner");
                image-fit: cover;
            }
        }

        Text {
            text: "TRUE ENTROPY";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-label;
            font-weight: Theme.font-weight-semibold;
            horizontal-alignment: center;
        }

        Card {
            width: 100%;
            title: "Welcome to DiceSeed";
            body: "Generate a BIP39 seed phrase from physical dice rolls — no electronic randomness involved.";
            footer: "Grab your dice and tap below to get started.";
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Button {
            width: 100%;
            text: "Get started";
            size: ControlSize.lg;
            full-width: true;
            clicked => {
                Navigate.word-count-page({ });
            }
        }
    }
}
